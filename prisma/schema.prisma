generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                    String               @id @default(cuid())
  name                  String?
  email                 String               @unique
  emailVerified         DateTime?
  image                 String?
  role                  String               @default("Creator") // Admin | Creator | Viewer
  status                String               @default("ACTIVE")  // ACTIVE | REVOKED
  level                 Int                  @default(0)
  plan                  String               @default("FREE")    // FREE | PRO | MAX
  credits               Int                  @default(200)
  smartMeshTrials       Int                  @default(2)
  partGenTrials         Int                  @default(1)
  texture8kTrials       Int                  @default(1)
  onboardingCompleted   Boolean              @default(false)
  onboardingCategory    String?
  onboardingSubCategory String?
  dccConnectionsJson    String               @default("{}")
  revokedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  passwordCredential    PasswordCredential?
  accounts              Account[]
  sessions              Session[]
  createdInvitations    Invitation[]         @relation("CreatedInvitations")
  consumedInvitations   Invitation[]         @relation("ConsumedInvitations")
  assets3d              Asset3D[]
  pre3dImages           Pre3DImage[]
  apiKeys               ApiKey[]
  apiTasks              ApiTask[]
  creditTransactions    CreditTransaction[]
  auditLogs             AuditLog[]
}

model PasswordCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  passwordHash      String
  passwordChangedAt DateTime  @default(now())
  resetTokenHash    String?   @unique
  resetExpiresAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id               String    @id @default(cuid())
  code             String    @unique
  tokenHash        String    @unique
  emailHint        String?
  role             String    @default("Creator") // Admin | Creator | Viewer
  status           String    @default("ACTIVE")  // ACTIVE | CONSUMED | REVOKED | EXPIRED
  maxUses          Int       @default(1)
  usedCount        Int       @default(0)
  note             String?
  expiresAt        DateTime
  consumedAt       DateTime?
  revokedAt        DateTime?
  createdByUserId  String?
  consumedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdBy        User?     @relation("CreatedInvitations", fields: [createdByUserId], references: [id], onDelete: SetNull)
  consumedBy       User?     @relation("ConsumedInvitations", fields: [consumedByUserId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String?
  action      String
  targetType  String
  targetId    String?
  ipAddress   String?
  detailsJson String   @default("{}")
  createdAt   DateTime @default(now())

  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorUserId])
}

model Asset3D {
  id              String   @id @default(cuid())
  ownerId         String?
  ownerName       String   @default("Tripo Creator")
  name            String
  prompt          String
  category        String   @default("character")
  generationMode  String   @default("HD_MODEL")   // HD_MODEL | SMART_MESH | UPLOAD | REMIX
  inputMode       String   @default("TEXT")       // IMAGE | MULTIVIEW | TEXT | SKETCH | UPLOAD
  aiModel         String   @default("H3.1")       // H3.1 | H3.0 | H2.5 | P2.0
  topology        String   @default("TRIANGLE")   // TRIANGLE | QUAD
  vertices        Int      @default(4096)
  faces           Int      @default(8192)
  targetPolycount Int      @default(50000)
  hasTexture      Boolean  @default(true)
  textureQuality  String   @default("4K")         // NONE | 2K | 4K | 8K
  hasPbr          Boolean  @default(true)
  removeLighting  Boolean  @default(false)
  ultraMesh       Boolean  @default(true)
  aiComplete      Boolean  @default(true)
  hasSmartUv      Boolean  @default(false)
  isSegmented     Boolean  @default(false)
  isRigged        Boolean  @default(false)
  activeAnimation String?
  privacy         String   @default("PUBLIC")     // PUBLIC | PRIVATE
  featured        Boolean  @default(false)
  likesCount      Int      @default(0)
  viewsCount      Int      @default(1)
  meshDataJson    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([privacy, category])
}

model Pre3DImage {
  id           String   @id @default(cuid())
  ownerId      String
  prompt       String
  template     String   @default("T Pose")
  modelName    String   @default("GPT Image 2.5")
  aspectRatio  String   @default("1:1")
  resolution4k Boolean  @default(false)
  svgDataUri   String
  createdAt    DateTime @default(now())

  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  status     String    @default("ACTIVE") // ACTIVE | REVOKED
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      ApiTask[]

  @@index([userId, status])
}

model ApiTask {
  id            String   @id @default(cuid())
  userId        String
  apiKeyId      String?
  type          String
  status        String   @default("success") // queued | running | success | failed
  progress      Int      @default(100)
  creditCost    Int      @default(55)
  inputJson     String   @default("{}")
  outputAssetId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey        ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  delta        Int
  balanceAfter Int
  reason       String
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
